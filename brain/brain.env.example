# Léamh brain config — copy this file to `brain.env` and fill it in.
#   cp brain.env.example brain.env
# `brain.env` is gitignored: your API key never gets committed.
# Real environment variables override anything set here.

# --- Upstream model (what the brain actually calls) ---------------------------
# Default upstream is Gemini's OpenAI-compatible endpoint. The MODEL is decided
# HERE, on the Mac — whatever you type in Layuv's model field is ignored.
BRAIN_UPSTREAM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
BRAIN_UPSTREAM_MODEL=gemini-2.5-flash

# Your held API key — stays on this Mac, never sent to the device, never logged.
# Get a free Gemini key at https://aistudio.google.com  (AIza...).
BRAIN_UPSTREAM_KEY=

# --- Your reference library ---------------------------------------------------
# Folder of plain-text/markdown files injected WHOLE into every request.
# Default is ~/layuv-brain/references (outside the repo, never committed).
BRAIN_REFERENCES_DIR=

# --- Listener -----------------------------------------------------------------
BRAIN_PORT=8077
# 0.0.0.0 lets the Supernote reach the brain across your LAN. Fine on a network
# you own. For remote/untrusted networks use Tailscale (a later phase).
BRAIN_BIND=0.0.0.0

# --- Optional device auth -----------------------------------------------------
# Leave blank on a trusted home LAN. If set, the device must send this exact
# value as its API key in Layuv's AI settings (defense-in-depth / shared net).
BRAIN_TOKEN=

# --- Swapping the upstream later ----------------------------------------------
# Claude via its OpenAI-compat endpoint (quality tier):
#   BRAIN_UPSTREAM_URL=https://api.anthropic.com/v1/chat/completions
#   BRAIN_UPSTREAM_MODEL=claude-sonnet-4-6
#   BRAIN_UPSTREAM_KEY=sk-ant-...
# A LOCAL model (nothing leaves your network — most private):
#   BRAIN_UPSTREAM_URL=http://127.0.0.1:8080/v1/chat/completions
#   BRAIN_UPSTREAM_MODEL=mlx-community/Qwen3-1.7B-4bit
#   BRAIN_UPSTREAM_KEY=        (local servers need no key)
