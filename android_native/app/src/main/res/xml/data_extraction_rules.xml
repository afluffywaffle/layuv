<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup / device-transfer. Exclude the encrypted API-key prefs from
     both cloud backup and device-to-device transfer (device-bound master key). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="leamh_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="leamh_secure.xml" />
    </device-transfer>
</data-extraction-rules>
