<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque paper fill + black border for dropdown popups, so they read as a
     distinct boxed surface on e-ink (the default Material popup is translucent
     with a soft shadow and looks messy over the list behind it). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/paper" />
    <stroke android:width="2dp" android:color="@color/ink" />
    <corners android:radius="2dp" />
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />
</shape>
