<?xml version="1.0" encoding="utf-8"?>
<!-- Lock picker card: paper fill, radius 10, 1dp black12 border, no shadow
     (Flutter LockPickerOverlay: black12 border + BorderRadius.circular(10)). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/paper" />
    <stroke android:width="@dimen/hairline" android:color="@color/ink_12" />
    <corners android:radius="@dimen/radius_card" />
</shape>
